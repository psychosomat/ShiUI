<section class="mx-auto max-w-md border-[1.5px] border-sumi bg-paper">
  <div class="border-b-[1.5px] border-sumi bg-sumi px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.2em] text-paper">Block 10 — Collector login</div>
  <div class="p-5 sm:p-6"><div class="font-display text-[24px] font-bold">Welcome back.</div><p class="font-sans text-[13px] opacity-70">Your folio kept its place on the rack.</p>
  <label for="shiui-email" class="mb-1.5 mt-5 block font-mono text-[11px] uppercase tracking-[0.18em]">Email</label><input id="shiui-email" value="studio@shiui.jp" class="w-full border-[1.5px] border-sumi bg-paper px-3.5 py-2.5 text-[14px] focus:border-shu focus:outline-none" />
  <label for="shiui-password" class="mb-1.5 mt-3 block font-mono text-[11px] uppercase tracking-[0.18em]">Password</label><div class="flex border-[1.5px] border-sumi"><input id="shiui-password" type="password" value="hinomaru" class="w-full px-3.5 py-2.5 tracking-[0.2em] focus:outline-none" /><button class="border-l-[1.5px] border-sumi px-3 font-mono text-[11px] uppercase">Show</button></div>
  <button class="mt-4 w-full border-[1.5px] border-sumi bg-shu py-2.5 font-mono text-[12px] uppercase tracking-[0.16em] text-paper">Enter →</button>
  <div class="mt-3 text-center font-mono text-[11px] uppercase tracking-[0.14em] opacity-60">New here? <span class="underline underline-offset-4">Claim a folio</span></div></div>
</section>
