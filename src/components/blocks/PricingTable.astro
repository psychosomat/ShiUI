      <div class="mx-auto mt-4 h-px w-12 bg-sumi/30"></div>
      <div class="mx-auto mt-4 inline-block border-[1.5px] border-sumi px-5 py-2 font-mono text-[11px] uppercase tracking-[0.16em]">Choose</div>
